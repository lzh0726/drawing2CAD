FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir cadquery==2.8.0
COPY server/container_runner.py server/policy.py /opt/cad/
ENV HOME=/tmp PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=2
WORKDIR /work
USER 65534:65534
ENTRYPOINT ["python", "-I", "/opt/cad/container_runner.py"]
